<?xml version="1.0" encoding="utf-8"?>
<!-- @VERSION@ and @VERSION_CODE@ are filled in by package.sh from native/Cargo.toml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.inkdown.editor"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION@">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Only for documents the user opens from a web address. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Inkdown"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:label="Inkdown"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density">

            <!-- the native library that holds the application -->
            <meta-data android:name="android.app.lib_name" android:value="inkdown_native" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with Inkdown" for text documents from a file manager or another app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/*" />
                <data android:scheme="file" android:mimeType="text/*" />
                <data android:scheme="content" android:mimeType="application/json" />
                <data android:scheme="content" android:mimeType="application/x-yaml" />
                <data android:scheme="content" android:mimeType="application/toml" />
                <data android:scheme="content" android:mimeType="image/svg+xml" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="content" android:mimeType="application/pdf" />
            </intent-filter>

            <!-- "Share" from another app, then Inkdown: text becomes a note, a file is opened -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- Files the user shares with another app are read through this, one file at a
             time and only by the app that was given permission for it. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="app.inkdown.editor.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
